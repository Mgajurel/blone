# Copy to .env and fill in the two secrets:
#   openssl rand -base64 36
NEXTAUTH_SECRET=
MEILI_MASTER_KEY=

# Optional overrides (defaults live in docker-compose.yml):
# KARAKEEP_VERSION=release
# INFERENCE_TEXT_MODEL=qwen3:8b       # alternative if tags look broken: llama3.1:8b (issue 003 tunes this)
# INFERENCE_IMAGE_MODEL=llava         # only used if you save images; `ollama pull llava` first

# Single-user hardening: uncomment AFTER creating your account, then `docker compose up -d` again.
# DISABLE_SIGNUPS=true

# For scripts and the custom UI (create in Karakeep: Settings -> API Keys):
KARAKEEP_API_KEY=
